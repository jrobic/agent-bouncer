{
  "name": "@jrobic/agent-bouncer",
  "version": "0.0.0",
  "description": "The bouncer for your coding agent's tool calls — a single guard binary with declarative TOML policy",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "bin": {
    "bouncer": "./dist/bouncer"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile ./src/cli.ts --outfile ./dist/bouncer",
    "lint": "oxlint src tests",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "verify": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dprint": "0.55.2",
    "oxlint": "1.78.0",
    "typescript": "^5.7.0"
  }
}
