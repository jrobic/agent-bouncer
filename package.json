{
  "name": "@jrobic/agent-bouncer",
  "version": "1.1.0",
  "description": "The bouncer for your coding agent's tool calls — a single guard binary with declarative TOML policy",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jonathan Robic",
  "keywords": [
    "agent",
    "cli",
    "policy",
    "security",
    "tooling"
  ],
  "repository": "git+https://github.com/jrobic/agent-bouncer.git",
  "homepage": "https://github.com/jrobic/agent-bouncer#readme",
  "bugs": "https://github.com/jrobic/agent-bouncer/issues",
  "engines": {
    "bun": ">=1.3"
  },
  "bin": {
    "bouncer": "./dist/bouncer"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "lint": "oxlint src tests scripts policy/harness/*.shim.ts",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "verify": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dprint": "0.55.2",
    "oxlint": "1.78.0",
    "typescript": "^5.7.0"
  }
}
