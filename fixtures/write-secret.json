{
  "family": "write-secret",
  "event": "PreToolUse",
  "check": "text",
  "cases": [
    {
      "id": "private-key-block",
      "text": "-----BEGIN RSA PRIVATE KEY-----\nMIIBOgIBAAJBAK\n-----END RSA PRIVATE KEY-----",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "private-key"
        }
      ]
    },
    {
      "id": "aws-access-key-id",
      "text": "const key = \"AKIAABCDEFGHIJKLMNOP\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "aws-access-key-id"
        }
      ]
    },
    {
      "id": "github-pat-classic",
      "text": "const t = \"ghp_abcdefghijklmnopqrstuvwxyz0123456789\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "github-pat"
        }
      ]
    },
    {
      "id": "github-pat-fine-grained",
      "text": "const t = \"github_pat_abcdefghijklmnopqrstuv\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "github-pat"
        }
      ]
    },
    {
      "id": "github-oauth-token",
      "text": "const t = \"ghu_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "github-token"
        }
      ]
    },
    {
      "id": "slack-token",
      "text": "const t = \"xoxb-1234567890-abcdefghij\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "slack-token"
        }
      ]
    },
    {
      "id": "google-api-key",
      "text": "const k = \"AIzaBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "google-api-key"
        }
      ]
    },
    {
      "id": "stripe-secret-key",
      "text": "const k = \"sk_live_abcdefghijklmnopqrstuvwx\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "stripe-secret-key"
        }
      ]
    },
    {
      "id": "jwt",
      "text": "const j = \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.abcdefghijklmnopqrs\";",
      "expected": [
        {
          "verdict": "block",
          "ruleId": "jwt"
        }
      ]
    },
    {
      "id": "ordinary-source-text-allowed",
      "text": "const safe = \"hello world\";",
      "expected": []
    },
    {
      "id": "empty-text-allowed",
      "text": "",
      "expected": []
    }
  ]
}
