    {
      "id": "known-limit-obfuscated-path-hex-printf",
      "check": "secret-bash",
      "command": "printf '\\x2e\\x65\\x6e\\x76' | xargs cat",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "the hex-encoded path never appears as literal text the path-token scan can read"
    },
    {
      "id": "known-limit-obfuscated-path-variable-indirection",
      "check": "secret-bash",
      "command": "F=secret_path_var; cat $F",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "no shell semantics: $F is never resolved to the path it names"
    },
    {
      "id": "known-limit-obfuscated-path-base64",
      "check": "secret-bash",
      "command": "cat $(echo Lmlu | base64 -d)nv",
      "expected": [],
      "knownLimit": true,
      "knownLimitReason": "command substitution and base64 decoding are never evaluated before the scan"
    },
    {
      "id": "url-creds-blocked",
      "check": "url",
      "url": "https://user:ghp_secret@api.example.com/repos",
